<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="j0aod3v.sistemaestoquemercado.controller.ProdutoViewController"
        stylesheets="@../css/style.css">

    <top>

        <VBox spacing="5">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label
                    text="Cadastro de Produto"
                    styleClass="titulo"/>

            <Label
                    text="Cadastre e gerencie os produtos do estoque."
                    styleClass="subtitulo"/>

        </VBox>

    </top>

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="10" right="25" bottom="25" left="25"/>
            </padding>

            <GridPane
                    hgap="15"
                    vgap="12"
                    styleClass="formulario">

                <Label
                        text="SKU:"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"/>

                <TextField
                        fx:id="txtSku"
                        promptText="Ex.: SKU-001"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"/>


                <Label
                        text="Código de barras:"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1"/>

                <TextField
                        fx:id="txtCodigoBarras"
                        promptText="Código de barras"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"/>


                <Label
                        text="Descrição:"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="2"/>

                <TextField
                        fx:id="txtDescricao"
                        promptText="Descrição do produto"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>


                <Label
                        text="Unidade:"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="3"/>

                <TextField
                        fx:id="txtUnidadeMedida"
                        promptText="Ex.: UN, KG, CX"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="3"/>


                <Label
                        text="Status:"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="4"/>

                <CheckBox
                        fx:id="chkAtivo"
                        text="Produto ativo"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="4"/>

            </GridPane>


            <HBox spacing="10">

                <Button
                        text="Cadastrar"
                        onAction="#cadastrarProduto"
                        styleClass="botao-principal"/>

                <Button
                        text="Limpar"
                        onAction="#limparCampos"
                        styleClass="botao-secundario"/>

            </HBox>


            <Label
                    text="Produtos cadastrados"
                    styleClass="secao-titulo"/>


            <TableView
                    fx:id="tabelaProdutos"
                    VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                            fx:id="colunaId"
                            text="ID"
                            prefWidth="60"/>

                    <TableColumn
                            fx:id="colunaSku"
                            text="SKU"
                            prefWidth="150"/>

                    <TableColumn
                            fx:id="colunaCodigoBarras"
                            text="Código de barras"
                            prefWidth="160"/>

                    <TableColumn
                            fx:id="colunaDescricao"
                            text="Descrição"
                            prefWidth="300"/>

                    <TableColumn
                            fx:id="colunaUnidade"
                            text="Unidade"
                            prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>